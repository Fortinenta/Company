@model CompanyWeb.Models.CabangViewModel

@{
    ViewData["Title"] = "Delete Cabang";
}

<div class="container mx-auto p-8 bg-white shadow-lg rounded-lg">
    <h1 class="text-3xl font-bold mb-6">Delete Cabang</h1>

    <h3 class="text-xl font-semibold text-red-600 mb-4">Are you sure you want to delete this?</h3>
    <div>
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.NamaCabang)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.NamaCabang)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Alamat)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Alamat)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Kota)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Kota)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.KodePos)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.KodePos)
            </dd>
        </dl>

        <form asp-action="Delete" class="mt-4">
            <input type="hidden" asp-for="CabangID" />
            <button type="submit" class="bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline">Delete</button> |
            <a asp-action="Index" class="inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800">Back to List</a>
        </form>
    </div>
</div>
