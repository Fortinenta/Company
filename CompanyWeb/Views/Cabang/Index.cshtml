@model IEnumerable<CompanyWeb.Models.CabangViewModel>

@{
    ViewData["Title"] = "Cabang List";
}

<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header with Search and Create Button -->
    <div class="mb-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
        <h1 class="text-3xl font-bold text-gray-900 mb-4 sm:mb-0">Cabang List</h1>
        <div class="flex space-x-3">
          <input type="text" placeholder="Search cabang..." class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
          <a asp-action="Create" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition duration-200">
            <i class="fas fa-plus mr-2"></i>Create New
          </a>
        </div>
      </div>
    </div>

    <!-- Responsive table wrapper -->
    <div class="bg-white shadow-sm rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        @if (Model?.Any() ?? false)
        {
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">@Html.DisplayNameFor(model => model.NamaCabang)</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">@Html.DisplayNameFor(model => model.Alamat)</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">@Html.DisplayNameFor(model => model.Kota)</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">@Html.DisplayNameFor(model => model.KodePos)</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              @foreach (var item in Model)
              {
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap">@Html.DisplayFor(modelItem => item.NamaCabang)</td>
                  <td class="px-6 py-4 whitespace-nowrap">@Html.DisplayFor(modelItem => item.Alamat)</td>
                  <td class="px-6 py-4 whitespace-nowrap">@Html.DisplayFor(modelItem => item.Kota)</td>
                  <td class="px-6 py-4 whitespace-nowrap">@Html.DisplayFor(modelItem => item.KodePos)</td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <a asp-action="Edit" asp-route-id="@item.CabangID" class="text-blue-600 hover:text-blue-800 font-medium">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.CabangID" class="text-green-600 hover:text-green-800 font-medium">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.CabangID" class="text-red-600 hover:text-red-800 font-medium">Delete</a>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        }
        else
        {
          <!-- Empty state -->
          <div class="text-center py-12">
            <i class="fas fa-building text-gray-400 text-4xl mb-4"></i>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No branches found</h3>
            <p class="text-gray-500 mb-4">Get started by creating a new branch.</p>
            <a asp-action="Create" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700">
              <i class="fas fa-plus mr-2"></i>Create First Branch
            </a>
          </div>
        }
      </div>
    </div>
  </div>
</div>