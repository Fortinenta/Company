@model CompanyWeb.Models.FileUploadViewModel

@{
    ViewData["Title"] = "Batch Update Pegawai";
}

<div class="container mx-auto p-8 bg-white shadow-lg rounded-lg">
    <h1 class="text-3xl font-bold mb-6">Batch Update Pegawai</h1>

    <div class="mb-6 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
        <h2 class="font-semibold text-lg text-yellow-800">Instructions</h2>
        <p class="text-yellow-700 mt-1">
            1. Upload the CSV file you exported from the main employee list.
        </p>
        <p class="text-yellow-700">
            2. Review and modify the editable data below. Pegawai ID and Nama Lengkap are read-only.
        </p>
        <p class="text-yellow-700">
            3. Click 'Save All Changes' to process the batch update.
        </p>
    </div>

    <form asp-action="BatchUpdate" method="post" enctype="multipart/form-data" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

        <div>
            <label asp-for="FormFile" class="block text-gray-700 text-sm font-bold mb-2"></label>
            <input asp-for="FormFile" type="file" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700" />
            <span asp-validation-for="FormFile" class="text-red-500 text-xs italic"></span>
        </div>

        <div class="flex items-center justify-between">
            <button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">Load File</button>
            <a asp-action="Index" class="inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800">Back to List</a>
        </div>
    </form>

    @if (Model.StagedPegawai != null && Model.StagedPegawai.Any())
    {
        <hr class="my-8" />
        <h2 class="text-2xl font-bold mb-4">Review Data for Update</h2>
        <form asp-action="SaveStagedData" method="post">
            <div class="bg-white shadow-md rounded-lg overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="min-w-full leading-normal">
                        <thead class="bg-gray-100 text-gray-700 uppercase text-sm leading-normal">
                            <tr>
                                <th class="py-3 px-6 text-left">ID</th>
                                <th class="py-3 px-6 text-left">Nama Lengkap (Read-Only)</th>
                                <th class="py-3 px-6 text-left">Email</th>
                                <th class="py-3 px-6 text-left">Status Kontrak</th>
                                <th class="py-3 px-6 text-left">Cabang</th>
                                <th class="py-3 px-6 text-left">Jabatan</th>
                            </tr>
                        </thead>
                        <tbody class="text-gray-800">
                            @for (var i = 0; i < Model.StagedPegawai.Count; i++)
                            {
                                <tr class="odd:bg-white even:bg-gray-50 hover:bg-gray-100">
                                    <td class="py-3 px-6 border-b border-gray-200">
                                        <input type="hidden" name="StagedPegawai[@i].PegawaiID" value="@Model.StagedPegawai[i].PegawaiID" />
                                        @Model.StagedPegawai[i].PegawaiID
                                    </td>
                                    <td class="py-3 px-6 border-b border-gray-200">
                                        <input type="hidden" name="StagedPegawai[@i].NamaLengkap" value="@Model.StagedPegawai[i].NamaLengkap" />
                                        @Model.StagedPegawai[i].NamaLengkap
                                    </td>
                                    <td class="py-3 px-6 border-b border-gray-200">
                                        <input type="email" name="StagedPegawai[@i].Email" value="@Model.StagedPegawai[i].Email" class="form-input w-full" />
                                    </td>
                                    <td class="py-3 px-6 border-b border-gray-200">
                                        <select name="StagedPegawai[@i].StatusKontrak" asp-for="@Model.StagedPegawai[i].StatusKontrak" asp-items="Model.StatusKontrakOptions" class="form-select w-full"></select>
                                    </td>
                                    <td class="py-3 px-6 border-b border-gray-200">
                                        <select name="StagedPegawai[@i].CabangID" asp-for="@Model.StagedPegawai[i].CabangID" asp-items="Model.CabangOptions" class="form-select w-full"></select>
                                    </td>
                                    <td class="py-3 px-6 border-b border-gray-200">
                                        <select name="StagedPegawai[@i].JabatanID" asp-for="@Model.StagedPegawai[i].JabatanID" asp-items="Model.JabatanOptions" class="form-select w-full"></select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="mt-6 flex justify-end">
                <button type="submit" class="bg-purple-600 hover:bg-purple-800 text-white font-bold py-2 px-6 rounded">Save All Changes</button>
            </div>
        </form>
    }
</div>