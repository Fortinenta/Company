@model CompanyWeb.Models.PegawaiViewModel

@{
    ViewData["Title"] = "Create Pegawai";
}

<div class="container mx-auto p-8 bg-white shadow-lg rounded-lg">
    <h1 class="text-3xl font-bold mb-6">Create Pegawai</h1>

    <form asp-action="Create" method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-4"></div>

        <div class="form-group">
            <label asp-for="NamaLengkap" class="block text-gray-700 text-sm font-bold mb-2"></label>
            <input asp-for="NamaLengkap" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" />
            <span asp-validation-for="NamaLengkap" class="text-red-500 text-xs italic"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email" class="block text-gray-700 text-sm font-bold mb-2"></label>
            <input asp-for="Email" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" />
            <span asp-validation-for="Email" class="text-red-500 text-xs italic"></span>
        </div>

        <div class="form-group">
            <label asp-for="NomorTelepon" class="block text-gray-700 text-sm font-bold mb-2"></label>
            <input asp-for="NomorTelepon" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" />
            <span asp-validation-for="NomorTelepon" class="text-red-500 text-xs italic"></span>
        </div>

        <div class="form-group">
            <label asp-for="TanggalLahir" class="block text-gray-700 text-sm font-bold mb-2"></label>
            <input asp-for="TanggalLahir" type="date" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" />
            <span asp-validation-for="TanggalLahir" class="text-red-500 text-xs italic"></span>
        </div>

        <div class="form-group">
            <label asp-for="Alamat" class="block text-gray-700 text-sm font-bold mb-2"></label>
            <input asp-for="Alamat" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" />
            <span asp-validation-for="Alamat" class="text-red-500 text-xs italic"></span>
        </div>

        <div class="form-group">
            <label asp-for="TanggalMasuk" class="block text-gray-700 text-sm font-bold mb-2"></label>
            <input asp-for="TanggalMasuk" type="date" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" />
            <span asp-validation-for="TanggalMasuk" class="text-red-500 text-xs italic"></span>
        </div>

        <div class="form-group">
            <label asp-for="StatusKontrak" class="block text-gray-700 text-sm font-bold mb-2"></label>
            <select asp-for="StatusKontrak" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                <option value="">-- Select Status --</option>
                <option value="Aktif">Aktif</option>
                <option value="Tidak Aktif">Tidak Aktif</option>
                <option value="Permanen">Permanen</option>
            </select>
            <span asp-validation-for="StatusKontrak" class="text-red-500 text-xs italic"></span>
        </div>

        <div class="form-group">
            <label asp-for="CabangID" class="block text-gray-700 text-sm font-bold mb-2"></label>
            <select asp-for="CabangID" asp-items="ViewBag.CabangList" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                <option value="">-- Select Cabang --</option>
            </select>
            <span asp-validation-for="CabangID" class="text-red-500 text-xs italic"></span>
        </div>

        <div class="form-group">
            <label asp-for="JabatanID" class="block text-gray-700 text-sm font-bold mb-2"></label>
            <select asp-for="JabatanID" asp-items="ViewBag.JabatanList" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                <option value="">-- Select Jabatan --</option>
            </select>
            <span asp-validation-for="JabatanID" class="text-red-500 text-xs italic"></span>
        </div>

        <div class="flex items-center justify-between mt-6">
            <button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline">Create</button>
            <a asp-action="Index" class="inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800">Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}