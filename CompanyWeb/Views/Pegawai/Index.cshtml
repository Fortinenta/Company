@model IEnumerable<CompanyWeb.Models.PegawaiViewModel>

@{
    ViewData["Title"] = "Pegawai List";
}

<div class="container mx-auto p-8 bg-white shadow-lg rounded-lg">
    <h1 class="text-3xl font-bold mb-6">Pegawai List</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">@TempData["ErrorMessage"]</span>
        </div>
    }

    <p class="mb-4">
        <a asp-action="Create" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg shadow-md transition duration-300 ease-in-out">Create New</a>
    </p>

    <form asp-action="Index" method="get" class="mb-4">
        <div class="flex items-center">
            <input type="text" name="searchNama" placeholder="Search by Name" class="shadow appearance-none border rounded py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" />
            <button type="submit" class="ml-2 bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline">Search</button>
            <a asp-action="Index" class="ml-2 bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline">Clear</a>
        </div>
    </form>

    <div class="overflow-x-auto">
        <table class="min-w-full border-collapse">
            <thead class="bg-gray-100 text-gray-700 uppercase text-sm leading-normal">
                <tr>
                    <th class="py-3 px-6 text-left border-b border-gray-300">@Html.DisplayNameFor(model => model.NamaLengkap)</th>
                    <th class="py-3 px-6 text-left border-b border-gray-300">@Html.DisplayNameFor(model => model.Email)</th>
                    <th class="py-3 px-6 text-left border-b border-gray-300">@Html.DisplayNameFor(model => model.NomorTelepon)</th>
                    <th class="py-3 px-6 text-left border-b border-gray-300">@Html.DisplayNameFor(model => model.TanggalLahir)</th>
                    <th class="py-3 px-6 text-left border-b border-gray-300">@Html.DisplayNameFor(model => model.Alamat)</th>
                    <th class="py-3 px-6 text-left border-b border-gray-300">@Html.DisplayNameFor(model => model.TanggalMasuk)</th>
                    <th class="py-3 px-6 text-left border-b border-gray-300">@Html.DisplayNameFor(model => model.StatusKontrak)</th>
                    <th class="py-3 px-6 text-left border-b border-gray-300">@Html.DisplayNameFor(model => model.NamaCabang)</th>
                    <th class="py-3 px-6 text-left border-b border-gray-300">@Html.DisplayNameFor(model => model.NamaJabatan)</th>
                    <th class="py-3 px-6 text-left border-b border-gray-300">Actions</th>
                </tr>
            </thead>
            <tbody class="text-gray-800">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50">
                        <td class="py-3 px-6 border-b border-gray-200">@Html.DisplayFor(modelItem => item.NamaLengkap)</td>
                        <td class="py-3 px-6 border-b border-gray-200">@Html.DisplayFor(modelItem => item.Email)</td>
                        <td class="py-3 px-6 border-b border-gray-200">@Html.DisplayFor(modelItem => item.NomorTelepon)</td>
                        <td class="py-3 px-6 border-b border-gray-200">@(item.TanggalLahir?.ToString("yyyy-MM-dd"))</td>
                        <td class="py-3 px-6 border-b border-gray-200">@Html.DisplayFor(modelItem => item.Alamat)</td>
                        <td class="py-3 px-6 border-b border-gray-200">@(item.TanggalMasuk.ToString("yyyy-MM-dd"))</td>
                        <td class="py-3 px-6 border-b border-gray-200">@Html.DisplayFor(modelItem => item.StatusKontrak)</td>
                        <td class="py-3 px-6 border-b border-gray-200">@Html.DisplayFor(modelItem => item.NamaCabang)</td>
                        <td class="py-3 px-6 border-b border-gray-200">@Html.DisplayFor(modelItem => item.NamaJabatan)</td>
                        <td class="py-3 px-6 border-b border-gray-200">
                            <a asp-action="Edit" asp-route-id="@item.PegawaiID" class="text-blue-600 hover:text-blue-800 font-medium">Edit</a> |
                            <a asp-action="Details" asp-route-id="@item.PegawaiID" class="text-green-600 hover:text-green-800 font-medium">Details</a> |
                            <a asp-action="Delete" asp-route-id="@item.PegawaiID" class="text-red-600 hover:text-red-800 font-medium">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
>
