@model CompanyWeb.Models.FileUploadViewModel

@{
    ViewData["Title"] = "Upload Pegawai Data";
}

<div class="container mx-auto p-8 bg-white shadow-lg rounded-lg">
    <h1 class="text-3xl font-bold mb-6">Upload Pegawai Data</h1>

    <div class="mb-6 p-4 bg-blue-50 border border-blue-200 rounded-lg">
        <h2 class="font-semibold text-lg text-blue-800">Instructions</h2>
        <p class="text-blue-700 mt-1">
            1. Download the CSV template file.
        </p>
        <p class="text-blue-700">
            2. Fill in the employee data under the provided headers.
        </p>
        <p class="text-blue-700">
            3. Upload the modified file using the form below.
        </p>
        <a asp-action="DownloadTemplate" class="mt-4 inline-block bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline">
            Download Template
        </a>
    </div>

    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

        <div>
            <label asp-for="FormFile" class="block text-gray-700 text-sm font-bold mb-2"></label>
            <input asp-for="FormFile" type="file" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" />
            <span asp-validation-for="FormFile" class="text-red-500 text-xs italic"></span>
        </div>

        <div class="flex items-center justify-between">
            <button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline">Upload</button>
            <a asp-action="Index" class="inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800">Back to List</a>
        </div>
    </form>

    @if (Model.StagedPegawai != null && Model.StagedPegawai.Any())
    {
        <hr class="my-8" />
        <h2 class="text-2xl font-bold mb-4">Review Uploaded Data</h2>
        <form asp-action="SaveStagedData" method="post">
            <div class="overflow-x-auto bg-white rounded-lg shadow">
                <table class="min-w-full leading-normal">
                    <thead>
                        <tr>
                            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Nama Lengkap</th>
                            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Email</th>
                            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Tanggal Lahir</th>
                            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Tanggal Masuk</th>
                            <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.StagedPegawai.Count; i++)
                        {
                            <tr>
                                <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                                    <input type="hidden" name="StagedPegawai[@i].PegawaiID" value="@Model.StagedPegawai[i].PegawaiID" />
                                    <input type="text" name="StagedPegawai[@i].NamaLengkap" value="@Model.StagedPegawai[i].NamaLengkap" class="form-input w-full" />
                                </td>
                                <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                                    <input type="email" name="StagedPegawai[@i].Email" value="@Model.StagedPegawai[i].Email" class="form-input w-full" />
                                </td>
                                <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                                    <input type="date" name="StagedPegawai[@i].TanggalLahir" value="@Model.StagedPegawai[i].TanggalLahir?.ToString("yyyy-MM-dd")" class="form-input w-full" />
                                </td>
                                <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                                    <input type="date" name="StagedPegawai[@i].TanggalMasuk" value="@Model.StagedPegawai[i].TanggalMasuk.ToString("yyyy-MM-dd")" class="form-input w-full" />
                                </td>
                                <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm text-right">
                                    <button type="button" class="text-red-500 hover:text-red-700 delete-staged-row">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-6 flex justify-end">
                <button type="submit" class="bg-purple-600 hover:bg-purple-800 text-white font-bold py-2 px-6 rounded">Save All to Database</button>
            </div>
        </form>
    }
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.delete-staged-row').forEach(button => {
                button.addEventListener('click', function () {
                    this.closest('tr').remove();
                });
            });
        });
    </script>
}
